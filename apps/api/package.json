{
	"name": "@1dragon/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/main.ts",
		"build": "tsup src/main.ts --format esm --dts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"validate:agentic:curl": "bash scripts/validate-agentic-job.sh",
		"validate:agentic:smoke": "node scripts/agentic-smoke-test.mjs",
		"db:seed:plans": "tsx src/infrastructure/persistence/seeds/plans.seed.ts",
		"db:seed:model-persona": "tsx src/infrastructure/persistence/seeds/model-persona-presets.seed.ts",
		"db:seed:style-presets": "tsx src/infrastructure/persistence/seeds/style-presets.seed.ts",
		"db:seed:platform-specs": "tsx src/infrastructure/persistence/seeds/platform-specs.seed.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.988.0",
		"@aws-sdk/s3-request-presigner": "^3.988.0",
		"@better-auth/drizzle-adapter": "1.5.0-beta.9",
		"@hono/node-server": "^1.19.9",
		"@sentry/node": "^10.38.0",
		"@1dragon/shared": "workspace:*",
		"better-auth": "^1.4.18",
		"bullmq": "^5.68.0",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.7.0",
		"ioredis": "^5.9.2",
		"pg": "^8.18.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"reflect-metadata": "^0.2.2",
		"sharp": "^0.34.5",
		"tsyringe": "^4.10.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@1dragon/typescript-config": "workspace:*",
		"@types/pg": "^8.16.0",
		"@vitest/coverage-v8": "^3.0.0",
		"drizzle-kit": "^0.31.9",
		"tsup": "^8.4.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
