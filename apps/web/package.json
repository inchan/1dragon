		"better-auth": "^1.4.18",
		"i18next": "^25.8.6",
		"i18next-browser-languagedetector": "^8.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-i18next": "^16.5.4"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@snapvid/eslint-config": "workspace:^",
		"@snapvid/typescript-config": "workspace:*",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.0",
		"@vitest/coverage-v8": "^3.0.0",
		"eslint": "^9.0.0",
