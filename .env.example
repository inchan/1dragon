# ============================================================
# .env.example — 실제 값은 apps/api/.env, apps/web/.env에 입력
# 이 파일은 git에 커밋됩니다 (템플릿 목적)
# ============================================================

# ── API Server (apps/api/.env) ────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snapvid
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=snapvid-local

# I2V 프로바이더 (키 없으면 simulate 모드)
GEMINI_VEO_API_KEY=        # Google AI Studio → API Keys
RUNWAY_API_KEY=            # 선택
HAILUO_API_KEY=            # 선택
MINIMAX_API_KEY=           # 선택

# Auth (선택)
KAKAO_CLIENT_ID=
GOOGLE_CLIENT_ID=

# SNS Sharing (선택)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Payments (선택)
TOSSPAYMENTS_SECRET=
TOSSPAYMENTS_WEBHOOK_SECRET=

# Monitoring (선택)
SENTRY_DSN=
APP_VERSION=0.1.0
LOG_LEVEL=debug

# ── Web Frontend (apps/web/.env) ──────────────────────────
VITE_API_URL=http://localhost:3001
